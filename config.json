        { "action": "navigate", "value": "http://localhost:5173/" },
        { "action": "wait", "value": 3000 },
        { "action": "upload", "selector": "input[type=\"file\"]", "value": "D:\\git_repo\\golfswingai\\images\\extracted_video.mp4" },
        { "action": "wait", "value": 10000 },
        { "action": "click", "selector": "text=Unlock Free" },
        { "action": "wait", "value": 10000 }
