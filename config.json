      "target_audience": "Amateur golfers looking to fix their swing mechanics, golf instructors, and club managers",
      "outreach_list": "contacts_golfers.csv",
      "reddit_subreddits": ["golfswing", "golf"],
      "reddit_keywords": ["swing", "slice", "hook", "early extension"],
      "kb_file": "knowledge_base/kb_golf.md",
      "few_shots_file": "knowledge_base/few_shots_golf.jsonl",
      "skipped_posts_file": "knowledge_base/skipped_posts_golf.jsonl",
